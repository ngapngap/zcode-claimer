{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "zcode-claimer",
  "version": "0.1.3",
  "identifier": "com.zcode.claimer",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm run dev:web",
    "beforeBuildCommand": "pnpm run build"
  },
  "app": {
    "windows": [
      {
        "title": "ZCode Claimer",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": ["https://raw.githubusercontent.com/ngapngap/zcode-claimer/main/updates/latest.json"],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdCNDc3QTUyNDlEMzRDOTEKUldTUlROTkpVbnBIZXl5OWh6dENybmM0VUJxcVhGK3JYbDJWZExkQkJZb3FlSmkzQ1lFWU15WGIK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
